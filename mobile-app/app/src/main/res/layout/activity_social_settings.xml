                            android:text="Baglanmadi"
                            android:textColor="#EF4444"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <EditText
                        android:id="@+id/etLinkedInCookies"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="8dp"
                        android:background="#334155"
                        android:hint="Cookie yapistirin..."
                        android:textColor="#F8FAFC"
                        android:textColorHint="#64748B"
                        android:padding="12dp"
                        android:inputType="textMultiLine"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                    <Button
                        android:id="@+id/btnLinkedInSave"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:text="Kaydet"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:backgroundTint="#0A66C2" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Facebook -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#1E293B"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Facebook"
                            android:textColor="#F8FAFC"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvFacebookStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Baglanmadi"
                            android:textColor="#EF4444"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <EditText
                        android:id="@+id/etFacebookCookies"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="8dp"
                        android:background="#334155"
                        android:hint="Cookie yapistirin..."
                        android:textColor="#F8FAFC"
                        android:textColorHint="#64748B"
                        android:padding="12dp"
                        android:inputType="textMultiLine"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                    <Button
                        android:id="@+id/btnFacebookSave"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:text="Kaydet"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:backgroundTint="#1877F2" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Twitter/X -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#1E293B"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Twitter / X"
                            android:textColor="#F8FAFC"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTwitterStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Baglanmadi"
                            android:textColor="#EF4444"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <EditText
                        android:id="@+id/etTwitterCookies"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="8dp"
                        android:background="#334155"
                        android:hint="Cookie yapistirin..."
                        android:textColor="#F8FAFC"
