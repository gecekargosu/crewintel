<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Status indicator -->
        <View
            android:id="@+id/viewStatus"
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:background="#EF4444"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDocName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="belge.pdf"
                android:textColor="#1e293b"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvDocType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PDF"
                    android:textColor="#64748b"
                    android:textSize="11sp"
                    android:background="#e2e8f0"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp" />

                <TextView
                    android:id="@+id/tvExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bitiş: 2026-12-31"
                    android:textColor="#94a3b8"
                    android:textSize="11sp"
                    android:layout_marginStart="8dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Status badge -->
        <TextView
            android:id="@+id/tvDocStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="unmatched"
            android:textColor="#EF4444"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#FEF2F2"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
