# Docker Compose development configuration. Copy to .env and replace placeholders.
APP_ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:8000

POSTGRES_DB=crewintel
POSTGRES_USER=crewintel
POSTGRES_PASSWORD=replace_with_a_local_development_password
MAX_UPLOAD_SIZE_MB=25
EXPIRY_APPROACHING_DAYS=90
EXPIRY_URGENT_DAYS=30
