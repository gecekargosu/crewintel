# Docker Compose development configuration. Copy to .env and replace placeholders.
APP_ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:8000

POSTGRES_DB=crewintel
POSTGRES_USER=crewintel
POSTGRES_PASSWORD=replace_with_a_local_development_password
MAX_UPLOAD_SIZE_MB=25
EXPIRY_APPROACHING_DAYS=90
EXPIRY_URGENT_DAYS=30

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong random secret for production, e.g. `openssl rand -hex 32`.
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
# First-time admin bootstrap (only used when no admin exists yet).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# ── AI (Groq) ──────────────────────────────────────────────────────────────
# Free key: https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
